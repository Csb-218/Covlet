{
  "name": "covlet",
  "description": "A Chrome extension that reads job descriptions on platforms like LinkedIn, Wellfound, and Internshala, then generates personalized cover letters designed to get you noticed.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@editorjs/editorjs": "^2.30.8",
    "@hookform/resolvers": "^5.1.1",
    "@mistralai/mistralai": "^1.7.4",
    "@react-oauth/google": "^0.12.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "@tiptap/pm": "^3.0.1",
    "@tiptap/react": "^3.0.1",
    "@tiptap/starter-kit": "^3.0.1",
    "axios": "^1.10.0",
    "dotenv": "^17.2.0",
    "framer-motion": "^12.23.0",
    "jspdf": "^3.0.1",
    "lodash": "^4.17.21",
    "postcss": "^8.5.6",
    "quill": "^2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "^7.6.3",
    "tailwindcss": "^4.1.11",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
